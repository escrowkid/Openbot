# Openbot — Apache / cPanel rules
#
# Makes index.html the homepage, routes /api/* into api.php, and disables
# response buffering so the chat stream actually streams.

DirectoryIndex index.html

# Route /api/{action} requests into api.php (frontend keeps the same paths
# it uses against the Node server).
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Don't rewrite real files / dirs.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # /api          -> api.php
    # /api/         -> api.php
    # /api/foo[/]   -> api.php?action=foo
    RewriteRule ^api/?$ api.php [L]
    RewriteRule ^api/([a-zA-Z0-9_-]+)/?$ api.php?action=$1 [QSA,L]
</IfModule>

# Hide server-only files from the public web.
<FilesMatch "^(server\.js|package(-lock)?\.json|\.env|\.gitignore|\.htaccess)$">
    Require all denied
</FilesMatch>

# Don't compress or buffer the SSE chat stream — would break streaming.
<IfModule mod_deflate.c>
    SetEnvIfNoCase Request_URI "^/api/chat" no-gzip dont-vary
    SetEnvIfNoCase Request_URI "^/api/chat" no-brotli
</IfModule>
<IfModule mod_brotli.c>
    SetEnvIfNoCase Request_URI "^/api/chat" no-brotli
</IfModule>

# PHP runtime tweaks (mod_php only — for FastCGI/LiteSpeed see .user.ini).
<IfModule mod_php.c>
    php_value output_buffering 0
    php_flag  zlib.output_compression off
    php_value max_execution_time 0
    php_value post_max_size 32M
    php_value upload_max_filesize 16M
</IfModule>
<IfModule mod_php7.c>
    php_value output_buffering 0
    php_flag  zlib.output_compression off
    php_value max_execution_time 0
    php_value post_max_size 32M
    php_value upload_max_filesize 16M
</IfModule>
<IfModule mod_php8.c>
    php_value output_buffering 0
    php_flag  zlib.output_compression off
    php_value max_execution_time 0
    php_value post_max_size 32M
    php_value upload_max_filesize 16M
</IfModule>

# Static asset caching (skip the API).
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|svg|png|jpe?g|gif|webp|ico)$">
        Header set Cache-Control "public, max-age=3600"
    </FilesMatch>
</IfModule>

# Defensive MIME types in case the host is missing them.
AddType text/css            .css
AddType application/javascript  .js
AddType image/svg+xml       .svg
